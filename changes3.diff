@@ -1,26 +1,282 @@
 @import "tailwindcss";
 
+/* ============================================================
+   ART TRACK WORKSTATION — DESIGN SYSTEM (Tailwind CSS v4)
+   Retro-Futuristic Media Workstation Theme
+   ============================================================ */
+
+@theme inline {
+  /* Background Colors */
+  --color-bg: #0A0A0A;
+  --color-bg-panel: #101010;
+  --color-bg-surface: #161616;
+  --color-bg-elevated: #1A1A1A;
+  --color-bg-hover: #1E1E1E;
+  --color-bg-active: #242424;
+
+  /* Text Colors */
+  --color-text-primary: #EAEAEA;
+  --color-text-secondary: #CFCFCF;
+  --color-text-muted: #8A8A8A;
+  --color-text-dim: #555555;
+
+  /* Accent Colors */
+  --color-accent-green: #00FF9C;
+  --color-accent-blue: #00D4FF;
+  --color-accent-yellow: #FFD500;
+  --color-accent-red: #FF4D6D;
+  --color-accent-purple: #B44DFF;
+
+  /* Border Colors */
+  --color-border: #2A2A2A;
+  --color-border-light: #3A3A3A;
+  --color-border-focus: #00D4FF;
+
+  /* Typography */
+  --font-sans: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
+  --font-pixel: var(--font-vt323), "Courier New", monospace;
+  --font-mono: var(--font-ibm-plex), ui-monospace, "Cascadia Code", monospace;
+}
+
+/* ============================================================
+   BASE STYLES
+   ============================================================ */
+
 :root {
-  --background: #ffffff;
-  --foreground: #171717;
+  --scrollbar-width: 6px;
+  color-scheme: dark;
 }
 
-@theme inline {
-  --color-background: var(--background);
-  --color-foreground: var(--foreground);
-  --font-sans: var(--font-geist-sans);
-  --font-mono: var(--font-geist-mono);
+* {
+  scrollbar-width: thin;
+  scrollbar-color: #333 #121212;
+}
+
+html, body {
+  height: 100%;
+  overflow: hidden;
+  background: var(--color-bg);
+  color: var(--color-text-primary);
+}
+
+::selection {
+  background: var(--color-accent-green);
+  color: #000;
+}
+
+/* ============================================================
+   SCROLLBAR STYLING
+   ============================================================ */
+
+::-webkit-scrollbar {
+  width: var(--scrollbar-width);
+  height: var(--scrollbar-width);
+}
+
+::-webkit-scrollbar-track {
+  background: #0e0e0e;
+}
+
+::-webkit-scrollbar-thumb {
+  background: #2a2a2a;
+  border-radius: 0;
+}
+
+::-webkit-scrollbar-thumb:hover {
+  background: #444;
+}
+
+::-webkit-scrollbar-corner {
+  background: #0e0e0e;
+}
+
+/* ============================================================
+   RANGE INPUT — HARDWARE SLIDER AESTHETIC
+   ============================================================ */
+
+input[type="range"] {
+  -webkit-appearance: none;
+  appearance: none;
+  background: transparent;
+  cursor: pointer;
+  height: 16px;
+}
+
+input[type="range"]::-webkit-slider-runnable-track {
+  height: 3px;
+  background: linear-gradient(to right, var(--color-accent-green), var(--color-border));
+  border: 1px solid var(--color-border);
+}
+
+input[type="range"]::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 10px;
+  height: 14px;
+  background: var(--color-text-primary);
+  border: 1px solid var(--color-border);
+  margin-top: -6px;
+  cursor: grab;
+}
+
+input[type="range"]::-webkit-slider-thumb:active {
+  cursor: grabbing;
+  background: var(--color-accent-green);
+}
+
+input[type="range"]::-moz-range-track {
+  height: 3px;
+  background: var(--color-border);
+  border: 1px solid var(--color-border);
+}
+
+input[type="range"]::-moz-range-thumb {
+  width: 10px;
+  height: 14px;
+  background: var(--color-text-primary);
+  border: 1px solid var(--color-border);
+  border-radius: 0;
+  cursor: grab;
+}
+
+input[type="range"]::-moz-range-thumb:active {
+  cursor: grabbing;
+  background: var(--color-accent-green);
 }
 
-@media (prefers-color-scheme: dark) {
-  :root {
-    --background: #0a0a0a;
-    --foreground: #ededed;
-  }
+input[type="range"]:focus {
+  outline: none;
 }
 
-body {
-  background: var(--background);
-  color: var(--foreground);
-  font-family: Arial, Helvetica, sans-serif;
+input[type="range"]:focus::-webkit-slider-thumb {
+  box-shadow: 0 0 4px var(--color-accent-green);
+}
+
+/* ============================================================
+   CRT / SCANLINE OVERLAY UTILITIES
+   ============================================================ */
+
+.crt-overlay {
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  background:
+    repeating-linear-gradient(
+      0deg,
+      transparent,
+      transparent 1px,
+      rgba(0, 0, 0, 0.08) 1px,
+      rgba(0, 0, 0, 0.08) 2px
+    );
+  z-index: 99;
+}
+
+.crt-glow {
+  text-shadow: 0 0 4px currentColor;
+}
+
+.led-indicator {
+  width: 6px;
+  height: 6px;
+  border-radius: 1px;
+  box-shadow: 0 0 6px currentColor, 0 0 12px currentColor;
+}
+
+/* ============================================================
+   ANIMATIONS
+   ============================================================ */
+
+@keyframes scanline-sweep {
+  0% { transform: translateY(-100%); }
+  100% { transform: translateY(100vh); }
+}
+
+@keyframes blink-slow {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.3; }
+}
+
+@keyframes pulse-glow {
+  0%, 100% { box-shadow: 0 0 4px currentColor; }
+  50% { box-shadow: 0 0 12px currentColor, 0 0 20px currentColor; }
+}
+
+@keyframes tape-noise {
+  0% { transform: translateX(0) scaleY(1); }
+  10% { transform: translateX(-1px) scaleY(1.01); }
+  20% { transform: translateX(1px) scaleY(0.99); }
+  30% { transform: translateX(0) scaleY(1); }
+  100% { transform: translateX(0) scaleY(1); }
+}
+
+.animate-scanline-sweep {
+  animation: scanline-sweep 4s linear infinite;
+}
+
+.animate-blink-slow {
+  animation: blink-slow 2s ease-in-out infinite;
+}
+
+.animate-pulse-glow {
+  animation: pulse-glow 2s ease-in-out infinite;
+}
+
+/* ============================================================
+   PANEL DIVIDER / RESIZE HANDLE
+   ============================================================ */
+
+.resize-handle {
+  cursor: col-resize;
+  width: 3px;
+  background: var(--color-border);
+  transition: background 0.15s;
+}
+
+.resize-handle:hover,
+.resize-handle:active {
+  background: var(--color-accent-blue);
+}
+
+.resize-handle-h {
+  cursor: row-resize;
+  height: 3px;
+  background: var(--color-border);
+  transition: background 0.15s;
+}
+
+.resize-handle-h:hover,
+.resize-handle-h:active {
+  background: var(--color-accent-blue);
+}
+
+/* ============================================================
+   CONSOLE OUTPUT STYLING
+   ============================================================ */
+
+.console-line {
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 1.5;
+  padding: 1px 8px;
+  border-bottom: 1px solid rgba(42, 42, 42, 0.3);
+}
+
+.console-line-info { color: var(--color-text-muted); }
+.console-line-warn { color: var(--color-accent-yellow); }
+.console-line-error { color: var(--color-accent-red); }
+.console-line-success { color: var(--color-accent-green); }
+.console-line-timing {
