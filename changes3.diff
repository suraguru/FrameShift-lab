+import { create } from "zustand";
+import type { MediaItem } from "@/types";
+
+interface MediaState {
+  activeMedia: MediaItem | null;
+  mediaLibrary: MediaItem[];
+  setActiveMedia: (media: MediaItem | null) => void;
+  addMedia: (media: MediaItem) => void;
+  removeMedia: (id: string) => void;
+  clearLibrary: () => void;
+}
+
+export const useMediaStore = create<MediaState>((set) => ({
+  activeMedia: null,
+  mediaLibrary: [],
+  setActiveMedia: (media) => set({ activeMedia: media }),
+  addMedia: (media) =>
+    set((state) => ({ mediaLibrary: [...state.mediaLibrary, media] })),
+  removeMedia: (id) =>
+    set((state) => ({
+      mediaLibrary: state.mediaLibrary.filter((m) => m.id !== id),
+      activeMedia: state.activeMedia?.id === id ? null : state.activeMedia,
+    })),
+  clearLibrary: () => set({ mediaLibrary: [], activeMedia: null }),
+}));
