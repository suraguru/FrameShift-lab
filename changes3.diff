++    // ── Ghosting ──
++    if (ghosting > 0) {
++      outCtx.globalAlpha = ghosting / 100;
++      outCtx.drawImage(input, ghosting * 0.5, ghosting * 0.3);
++      outCtx.globalAlpha = 1;
++    }
