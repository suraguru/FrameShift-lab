++      encoder = new VideoEncoder({
++        output: (chunk, metadata) => {
++          if (metadata?.decoderConfig) {
++            // First chunk contains decoder config, add track to mp4box
++            videoTrackId = mp4boxfile.addTrack({
++              timescale: options!.fps,
++              width: options!.resolution === "source" ? 1920 : parseInt(options!.resolution) * 16/9, // Dummy, should be passed
++              height: parseInt(options!.resolution) || 1080,
