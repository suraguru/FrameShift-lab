diff --git a/src/engine/workers/DecodeWorker.ts b/src/engine/workers/DecodeWorker.ts
new file mode 100644
index 0000000..e494493
--- /dev/null
+++ b/src/engine/workers/DecodeWorker.ts
@@ -0,0 +1,89 @@
+"use client";
+
+// Next.js HMR polyfill for Web Workers
+if (typeof self !== "undefined" && !self.matchMedia) {
+  (self as any).matchMedia = function () {
+    return { matches: false, addListener: function () {}, removeListener: function () {}, addEventListener: function () {}, removeEventListener: function () {} };
+  };
+}
+
+import * as MP4Box from "mp4box";
+
+self.onmessage = async (e) => {
+  if (e.data.type === "INIT_DECODE") {
+    const file: File = e.data.payload.file;
+    const targetFps = e.data.payload.fps;
+    
+    // We will use mp4box to parse the file
+    const mp4boxfile = MP4Box.createFile();
+    
+    let videoTrack: any = null;
+    let decoder: VideoDecoder;
+    let frameCount = 0;
+
+    mp4boxfile.onReady = (info: any) => {
+      videoTrack = info.videoTracks[0];
+      if (!videoTrack) {
+        self.postMessage({ type: "ERROR", payload: "No video track found" });
+        return;
+      }
+
+      mp4boxfile.setExtractionOptions(videoTrack.id);
+      mp4boxfile.start();
+
+      decoder = new VideoDecoder({
+        output: (frame) => {
+          frameCount++;
+          // We can transfer the VideoFrame to the caller
+          (self as any).postMessage({
+            type: "FRAME_DECODED",
+            payload: { frame, frameIndex: frameCount }
+          }, [frame]);
+        },
+        error: (e) => {
+          self.postMessage({ type: "ERROR", payload: e.message });
+        }
+      });
+
+      // Configure decoder
+      const description = (mp4boxfile as any).getTrackById(videoTrack.id).codec_private_data;
+      decoder.configure({
+        codec: videoTrack.codec,
+        codedWidth: videoTrack.video.width,
+        codedHeight: videoTrack.video.height,
+        description: description,
+      });
+    };
+
+    mp4boxfile.onSamples = (id: number, user: any, samples: any[]) => {
+      for (const sample of samples) {
+        const chunk = new EncodedVideoChunk({
+          type: sample.is_sync ? "key" : "delta",
+          timestamp: (sample.cts * 1000000) / sample.timescale,
+          duration: (sample.duration * 1000000) / sample.timescale,
+          data: sample.data
+        });
+        decoder.decode(chunk);
+      }
+    };
+
+    // Read file in chunks to feed mp4box
+    const reader = file.stream().getReader();
+    let offset = 0;
+    
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      const buffer = value.buffer as any;
+      buffer.fileStart = offset;
+      offset += buffer.byteLength;
+      mp4boxfile.appendBuffer(buffer);
+    }
+    
+    mp4boxfile.flush();
+    
+    // Wait for decoding to finish
+    await decoder!.flush();
+    self.postMessage({ type: "DECODE_COMPLETE" });
+  }
+};
diff --git a/src/engine/workers/EncodeWorker.ts b/src/engine/workers/EncodeWorker.ts
new file mode 100644
index 0000000..b1fb7d3
--- /dev/null
+++ b/src/engine/workers/EncodeWorker.ts
@@ -0,0 +1,149 @@
+"use client";
+
+// Next.js HMR polyfill for Web Workers
+if (typeof self !== "undefined" && !self.matchMedia) {
+  (self as any).matchMedia = function () {
+    return { matches: false, addListener: function () {}, removeListener: function () {}, addEventListener: function () {}, removeEventListener: function () {} };
+  };
+}
+
+import * as MP4Box from "mp4box";
+import JSZip from "jszip";
+import type { ExportOptions } from "@/types";
+
+let encoder: any = null;
+let mp4boxfile: any = null;
+let videoTrackId: number = -1;
+let zip: JSZip | null = null;
+let options: ExportOptions | null = null;
+let frameCount = 0;
+let chunks: Uint8Array[] = [];
+
+// Helper to convert ImageBitmap to PNG ArrayBuffer
+async function bitmapToPNG(bitmap: ImageBitmap): Promise<ArrayBuffer> {
+  const canvas = new OffscreenCanvas(bitmap.width, bitmap.height);
+  const ctx = canvas.getContext("2d")!;
+  ctx.drawImage(bitmap, 0, 0);
+  const blob = await canvas.convertToBlob({ type: "image/png" });
+  return await blob.arrayBuffer();
+}
+
+self.onmessage = async (e: MessageEvent) => {
+  const { type, payload } = e.data;
+
+  if (type === "INIT_ENCODE") {
+    options = payload.options;
+    frameCount = 0;
+    
+    if (options!.format === "png_sequence") {
+      zip = new JSZip();
+      self.postMessage({ type: "ENCODE_READY" });
+    } else if (options!.format === "mp4" || options!.format === "webm") {
+      // Initialize MP4Box
+      mp4boxfile = MP4Box.createFile();
+      chunks = [];
+      
+      // We will capture the mp4box output
+      mp4boxfile.onData = (id: number, buffer: ArrayBuffer) => {
+        chunks.push(new Uint8Array(buffer));
+      };
+
+      const codec = options!.format === "mp4" ? "avc1.42E01E" : "vp09.00.10.08"; 
+      
+      encoder = new VideoEncoder({
+        output: (chunk, metadata) => {
+          if (metadata?.decoderConfig) {
+            // First chunk contains decoder config, add track to mp4box
+            videoTrackId = mp4boxfile.addTrack({
+              timescale: options!.fps,
+              width: options!.resolution === "source" ? 1920 : parseInt(options!.resolution) * 16/9, // Dummy, should be passed
+              height: parseInt(options!.resolution) || 1080,
+              avcDecoderConfigRecord: metadata.decoderConfig.description,
+            });
+          }
+          
+          if (videoTrackId !== -1) {
+            const buffer = new ArrayBuffer(chunk.byteLength);
+            chunk.copyTo(buffer);
+            mp4boxfile.addSample(videoTrackId, buffer, {
+              duration: 1, // 1 timescale unit = 1 frame
+              dts: chunk.timestamp,
+              cts: chunk.timestamp,
+              is_sync: chunk.type === "key"
+            });
+          }
+        },
+        error: (err) => {
+          self.postMessage({ type: "ERROR", payload: err.message });
+        }
+      });
+      
+      // We don't have the exact resolution yet until the first frame arrives
+      self.postMessage({ type: "ENCODE_READY" });
+    }
+  }
+
+  else if (type === "ADD_FRAME") {
+    const { bitmap } = payload;
+    frameCount++;
+
+    if (options!.format === "png_sequence") {
+      const pngBuffer = await bitmapToPNG(bitmap);
+      const filename = `frame_${frameCount.toString().padStart(6, '0')}.png`;
+      zip!.file(filename, pngBuffer);
+      self.postMessage({ type: "FRAME_ENCODED" });
+    } 
+    else if (options!.format === "mp4" || options!.format === "webm") {
+      if (encoder!.state === "unconfigured") {
+        encoder!.configure({
+          codec: options!.format === "mp4" ? "avc1.42E01E" : "vp09.00.10.08",
+          width: bitmap.width,
+          height: bitmap.height,
+          bitrate: options!.bitrate * 1000,
+          framerate: options!.fps,
+          hardwareAcceleration: "prefer-hardware",
+        });
+      }
+
+      const frame = new VideoFrame(bitmap, { timestamp: frameCount });
+      // Request keyframe every 2 seconds
+      encoder!.encode(frame, { keyFrame: frameCount % (options!.fps * 2) === 0 });
+      frame.close();
+      
+      // Wait for encoder queue to drain to prevent memory bloat
+      if (encoder!.encodeQueueSize > 5) {
+        await encoder!.flush();
+      }
+      
+      self.postMessage({ type: "FRAME_ENCODED" });
+    }
+    bitmap.close();
+  }
+
+  else if (type === "FINALIZE") {
+    if (options!.format === "png_sequence") {
+      self.postMessage({ type: "LOG", payload: { level: "info", message: "Zipping sequence..." } });
+      const blob = await zip!.generateAsync({ type: "blob" });
+      self.postMessage({ type: "ENCODE_COMPLETE", payload: { blob, filename: "sequence.zip" } });
+    } 
+    else if (options!.format === "mp4" || options!.format === "webm") {
+      await (encoder as VideoEncoder)!.flush();
+      (encoder as VideoEncoder)!.close();
+      
+      // Finish MP4Box
+      mp4boxfile.flush();
+      
+      // Combine chunks
+      const totalLength = chunks.reduce((acc, val) => acc + val.length, 0);
+      const result = new Uint8Array(totalLength);
+      let offset = 0;
+      for (const chunk of chunks) {
+        result.set(chunk, offset);
+        offset += chunk.length;
+      }
+      
+      const blob = new Blob([result], { type: options!.format === "mp4" ? "video/mp4" : "video/webm" });
+      self.postMessage({ type: "ENCODE_COMPLETE", payload: { blob, filename: `export.${options!.format}` } });
+    }
+  }
+};
