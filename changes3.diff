++    const detailRecovery = this.parameters.detailRecovery as number;
++    const glowAmount = this.parameters.glowAmount as number;
++    const glowRadius = this.parameters.glowRadius as number;
++
++    // Draw base
++    outCtx.drawImage(input, 0, 0);
