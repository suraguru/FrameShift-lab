++      const blurCtx = blurCanvas.getContext("2d")!;
++      blurCtx.filter = `blur(${frostedBlur}px)`;
++      blurCtx.drawImage(output, 0, 0);
++      outCtx.drawImage(blurCanvas, 0, 0);
++    }
++  }
++
++  private barrelDistortion(
